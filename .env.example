OWS_COMMUNITY_ENVIRONMENT=development
OWS_COMMUNITY_HOST=127.0.0.1
OWS_COMMUNITY_PORT=8000
OWS_COMMUNITY_FRONTEND_PORT=8765
OWS_COMMUNITY_STORE_BACKEND=redis
OWS_COMMUNITY_REDIS_URL=redis://127.0.0.1:6379/0
OWS_COMMUNITY_REDIS_PREFIX=ows-community
OWS_COMMUNITY_CORS_ORIGINS=["http://127.0.0.1:8765","http://localhost:8765"]
OWS_COMMUNITY_ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
OWS_COMMUNITY_DOCS_ENABLED=true
# Enable only for local development; generate a non-empty random key first.
OWS_COMMUNITY_DEV_LOGIN_ENABLED=false
OWS_COMMUNITY_DEV_LOGIN_KEY=
OWS_COMMUNITY_SESSION_TTL_SECONDS=28800
OWS_COMMUNITY_MAX_BODY_BYTES=2097152
# Publisher-only bearer token for POST /api/v1/ows-release/webhook.
OWS_COMMUNITY_OWS_RELEASE_WEBHOOK_TOKEN=
# Optional Feishu Bitable table (in FEISHU_BITABLE_APP_TOKEN) mirroring OWS install copy counts.
OWS_COMMUNITY_OWS_COPY_STATS_TABLE_ID=
OWS_COMMUNITY_FEISHU_APP_ID=
OWS_COMMUNITY_FEISHU_APP_SECRET=
OWS_COMMUNITY_FEISHU_BITABLE_APP_TOKEN=
OWS_COMMUNITY_MEDIA_ROOT=var/media

# Browser OAuth: use one canonical origin (no trailing slash).
OWS_COMMUNITY_SITE_ORIGIN=http://127.0.0.1:8765
OWS_COMMUNITY_COOKIE_SECURE=false
# Optional extra tenant restriction; custom-app availability is checked by Feishu.
OWS_COMMUNITY_FEISHU_ALLOWED_TENANTS=[]

# Enable after the user-profile permissions are approved and published in Feishu.
OWS_COMMUNITY_FEISHU_PROFILE_ENABLED=false

# AI officer directory (Feishu Base app token is distinct from OAuth app_id).
OWS_COMMUNITY_OFFICERS_TABLE_ID=
OWS_COMMUNITY_OFFICERS_VIEW_ID=
OWS_COMMUNITY_OFFICERS_CACHE_SECONDS=300
OWS_COMMUNITY_OFFICERS_STALE_SECONDS=604800
OWS_COMMUNITY_OFFICERS_SOURCE_TENANT=
OWS_COMMUNITY_MEDIA_MAX_BYTES=20971520

# AI cases: shared source cache, refreshed on demand.
OWS_COMMUNITY_CASES_TABLE_ID=
OWS_COMMUNITY_CASES_VIEW_ID=
OWS_COMMUNITY_CASES_CACHE_SECONDS=1800
OWS_COMMUNITY_CASES_STALE_SECONDS=604800
OWS_COMMUNITY_CASES_SOURCE_TENANT=
# 与案例在同一个 Base。来源 tbldtSGzcfa6twD0 默认使用 tblUTQgRmYHxdiuh，其他来源需指定。
OWS_COMMUNITY_CASES_ENGAGEMENT_TABLE_ID=
# 本地互动主库。生产默认 /var/lib/ows-community/case-interactions.sqlite3，两套 API 共用。
# OWS_COMMUNITY_CASE_INTERACTIONS_DB=/var/lib/ows-community/case-interactions.sqlite3
# 独立社区币流水 Base，沿用站点应用身份。已配置的案例源默认绑定流水表，自定义目标请同时填写两项。
OWS_COMMUNITY_COIN_BASE_TOKEN=
OWS_COMMUNITY_COIN_TABLE_ID=
# 个人列表入口：第一位为点赞，第二位为收藏。
OWS_COMMUNITY_CASE_PERSONAL_LISTS=01

# Homepage Banner: newest created row, title optional, shared 24-hour cache.
OWS_COMMUNITY_BANNER_TABLE_ID=
OWS_COMMUNITY_BANNER_VIEW_ID=
OWS_COMMUNITY_BANNER_CACHE_SECONDS=86400
OWS_COMMUNITY_BANNER_STALE_SECONDS=604800
OWS_COMMUNITY_BANNER_SOURCE_TENANT=

# AIHOT selected feed -> Feishu -> shared Redis snapshot.
# Disabled in the handoff template until the destination Feishu table is configured; enable for 600-second sync.
# Sync needs Redis, app permission bitable:app and write access to this table.
OWS_COMMUNITY_NEWS_TABLE_ID=
OWS_COMMUNITY_NEWS_VIEW_ID=
OWS_COMMUNITY_NEWS_SOURCE_TENANT=
OWS_COMMUNITY_NEWS_SYNC_ENABLED=false
OWS_COMMUNITY_NEWS_SYNC_INTERVAL_SECONDS=600
OWS_COMMUNITY_NEWS_CACHE_SECONDS=600
OWS_COMMUNITY_NEWS_STALE_SECONDS=86400
OWS_COMMUNITY_NEWS_SYNC_STATE_ROOT=var/news-sync

# FAQ: fields 问题 / 回复, view order, authenticated shared cache.
OWS_COMMUNITY_FAQ_TABLE_ID=
OWS_COMMUNITY_FAQ_VIEW_ID=
OWS_COMMUNITY_FAQ_CACHE_SECONDS=600
OWS_COMMUNITY_FAQ_STALE_SECONDS=86400
OWS_COMMUNITY_FAQ_SOURCE_TENANT=

# AI activities: shared cache refreshed automatically on TTL expiry (plus optional webhook).
OWS_COMMUNITY_ACTIVITIES_TABLE_ID=
OWS_COMMUNITY_ACTIVITIES_VIEW_ID=
OWS_COMMUNITY_ACTIVITIES_CACHE_SECONDS=120
OWS_COMMUNITY_ACTIVITIES_STALE_SECONDS=604800
OWS_COMMUNITY_ACTIVITIES_SOURCE_TENANT=
OWS_COMMUNITY_ACTIVITIES_WEBHOOK_TOKEN=

# Deployment: SQLite authority, Redis cache, Feishu reporting. Real execution is opt-in.
OWS_COMMUNITY_DEPLOY_ENABLED=true
OWS_COMMUNITY_DEPLOY_EXECUTION_ENABLED=false
OWS_COMMUNITY_DEPLOY_SYNC_ENABLED=false
OWS_COMMUNITY_DEPLOY_STATE_ROOT=var/deployment
OWS_COMMUNITY_DEPLOY_TENANT_ID=
OWS_COMMUNITY_DEPLOY_ALLOWED_USERS=[]
OWS_COMMUNITY_DEPLOY_APPS_TABLE_ID=
OWS_COMMUNITY_DEPLOY_JOBS_TABLE_ID=
# Linux only; copy deploy/deployment/engine.example.json and fill actual paths/identity.
# OWS_COMMUNITY_DEPLOY_ENGINE_CONFIG=/etc/ows-deployment/engine.json

# Local assistant opt-in. Credentials reuse the existing OWS Feishu app.
# Requires aily:agent_chat:read/write + Aily OpenAPI caller allowlist.
OWS_COMMUNITY_ASSISTANT_ENABLED=false
OWS_COMMUNITY_ASSISTANT_AGENT_ID=
OWS_COMMUNITY_ASSISTANT_SOURCE_TENANT=
OWS_COMMUNITY_ASSISTANT_FEEDBACK_BASE=
OWS_COMMUNITY_ASSISTANT_FEEDBACK_TABLE=

# Optional: pre-provisioned shared SQLite group for separate API/worker Unix users.
# OWS_COMMUNITY_DEPLOY_DATABASE_GID=

# Editable switches in the coin Base. Set both on deployments that use Feishu.
OWS_COMMUNITY_SITE_SWITCH_TABLE_ID=
OWS_COMMUNITY_SITE_SWITCH_WEBHOOK_TOKEN=
